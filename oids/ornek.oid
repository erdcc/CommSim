# =====================================================================
#  Örnek SNMP OID tablosu. Satır biçimi:
#     <OID>  <TİP>  <ro|rw>  <değer>
#  Tipler: INTEGER OCTET_STRING HEX_STRING OID IPADDRESS COUNTER32
#          GAUGE32 TIMETICKS COUNTER64 NULL
#  OCTET_STRING tırnaklı yazılabilir: "metin \"alıntı\""
#  TIMETICKS için @uptime: agent başlatıldığından beri geçen süre.
#  Değerler SNMP sekmesinden düzenlenip "Kaydet" ile bu dosyaya yazılabilir.
# =====================================================================

# system grubu (RFC 1213)
1.3.6.1.2.1.1.1.0   OCTET_STRING  ro  "Simüle cihaz - Haberleşme simülatörü"
1.3.6.1.2.1.1.2.0   OID           ro  1.3.6.1.4.1.99999.1
1.3.6.1.2.1.1.3.0   TIMETICKS     ro  @uptime
1.3.6.1.2.1.1.4.0   OCTET_STRING  rw  "operator@example.com"
1.3.6.1.2.1.1.5.0   OCTET_STRING  rw  "sim-cihaz-01"
1.3.6.1.2.1.1.6.0   OCTET_STRING  rw  "Test laboratuvarı"
1.3.6.1.2.1.1.7.0   INTEGER       ro  72

# interfaces (2 arayüz)
1.3.6.1.2.1.2.1.0       INTEGER       ro  2
1.3.6.1.2.1.2.2.1.1.1   INTEGER       ro  1
1.3.6.1.2.1.2.2.1.1.2   INTEGER       ro  2
1.3.6.1.2.1.2.2.1.2.1   OCTET_STRING  ro  "eth0"
1.3.6.1.2.1.2.2.1.2.2   OCTET_STRING  ro  "eth1"
1.3.6.1.2.1.2.2.1.5.1   GAUGE32       ro  1000000000
1.3.6.1.2.1.2.2.1.5.2   GAUGE32       ro  100000000
1.3.6.1.2.1.2.2.1.6.1   HEX_STRING    ro  02 00 00 00 00 01
1.3.6.1.2.1.2.2.1.6.2   HEX_STRING    ro  02 00 00 00 00 02
1.3.6.1.2.1.2.2.1.8.1   INTEGER       rw  1
1.3.6.1.2.1.2.2.1.8.2   INTEGER       rw  2
1.3.6.1.2.1.2.2.1.10.1  COUNTER32     ro  123456
1.3.6.1.2.1.2.2.1.10.2  COUNTER32     ro  0

# örnek kurumsal dal (deneme amaçlı 99999)
1.3.6.1.4.1.99999.1.1.0  INTEGER       rw  25
1.3.6.1.4.1.99999.1.2.0  OCTET_STRING  rw  "NORMAL"
1.3.6.1.4.1.99999.1.3.0  IPADDRESS     rw  192.168.1.10
1.3.6.1.4.1.99999.1.4.0  COUNTER64     ro  9876543210
